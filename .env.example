APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Izinkan migrate:fresh, migrate:refresh, migrate:reset, db:wipe (menghapus data).
# Biarkan false agar tidak terhapus tidak sengaja; set true hanya saat setup ulang DB.
ALLOW_MIGRATE_FRESH=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# AI (OpenRouter) — set salah satu kunci API. AI_AKTIF opsional: jika tidak di-set, aktif otomatis bila kunci ada; false = paksa mati.
# AI_AKTIF=false
# Kunci: pakai OPENROUTER_API_KEY atau AI_OPENROUTER_API_KEY (sama prioritas setelah strip kosong)
OPENROUTER_API_KEY=
# AI_OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# AI_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free
# Beberapa model (dropdown + fallback bergantian): id:Label dipisah koma
# Kosongkan AI_OPENROUTER_MODELS untuk memakai daftar model gratis bawaan di bawah
# Wajib pakai tanda kutip jika label ada spasi (format id:Label, dipisah koma):
# AI_OPENROUTER_MODELS="google/gemini-2.0-flash-exp:free:Gemini Flash Gratis,meta-llama/llama-3.2-3b-instruct:free:Llama 3.2 Gratis"
OPENROUTER_TEMPERATURE=0.2
AI_OPENROUTER_MAX_TOKENS=
AI_OPENROUTER_MAX_TOKENS_BULK=8192
# Batas waktu: koneksi TCP (detik) dan tunggu respons per model (habis → model berikutnya)
AI_OPENROUTER_CONNECT_TIMEOUT=12
AI_OPENROUTER_TIMEOUT_PER_MODEL=45
# true = coba model lain di daftar bila timeout / error server (429, 5xx, dll.)
AI_OPENROUTER_FALLBACK=true
OPENROUTER_RETRY_TOTAL=0
OPENROUTER_RETRY_DELAY_MS=400
# database = analisis di background (lebih cepat di browser); sync = tunggu di halaman
AI_QUEUE_CONNECTION=database
AI_QUEUE_NAME=ai-analysis
AI_QUEUE_TRIES=3
AI_QUEUE_TIMEOUT=120
AI_QUEUE_BACKOFF=10
AI_TRIGGER_PER_MINUTE=20
AI_JOB_PER_MINUTE=30

# Speech-to-text — transkripsi bukti wawancara
# STT_AKTIF=false
# groq = gratis (tier Groq, perlu GROQ_API_KEY) | openrouter = berbayar (OPENROUTER_API_KEY)
STT_PROVIDER=groq
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
STT_MODEL=openai/whisper-large-v3-turbo
STT_LANGUAGE=id
STT_SILENCE_GAP_DETIK=1.5
STT_MAX_FILE_MB=100
STT_CHUNK_AKTIF=true
STT_CHUNK_MAX_MB=24
STT_CHUNK_DURASI_DETIK=600
STT_CHUNK_OVERLAP_DETIK=10
# STT_FFMPEG_PATH=C:\laragon\bin\ffmpeg\ffmpeg-6.1-win64\bin\ffmpeg.exe
STT_QUEUE_CONNECTION=sync
STT_QUEUE_NAME=stt-transcription
STT_QUEUE_TIMEOUT=600
